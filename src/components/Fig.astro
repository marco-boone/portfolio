---
// Placeholder for a figure that hasn't been made yet.
// In an .mdx file: <Fig todo="what the figure should show" />
// Shows as a dashed box in dev and in the build, so gaps are easy to spot.
interface Props {
  todo: string;
}

const { todo } = Astro.props;
---

<figure class="!border-dashed !border-yellow/60 !bg-yellow/5">
  <p class="text-xs font-bold uppercase tracking-wider !text-yellow">figure todo</p>
  <p class="!text-subtext1">{todo}</p>
</figure>
