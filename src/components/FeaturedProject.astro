---
interface Props {
  title: string;
  href: string;
  github: string;
  blurb: string;
  tags?: string[];
  private?: boolean;
}

const { title, href, github, blurb, tags = [], private: isPrivate = false } = Astro.props;
---

<li class="group flex flex-col gap-2 rounded-md border border-overlay0 bg-surface0/40 p-4 transition-colors hover:border-blue">
  <a class="text-text font-bold transition-colors group-hover:text-blue" href={href}>{title}</a>
  <p class="text-subtext0">{blurb}</p>
  {
    tags.length > 0 && (
      <ul class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="text-overlay2 text-[10px] uppercase tracking-wider border border-overlay0 rounded px-1.5 py-0.5">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
  <div class="flex flex-wrap items-center gap-4 pt-1">
    <a class="link-accent" href={href}>details &rarr;</a>
    <a class="link-accent" href={github}>github</a>
    {
      isPrivate && (
        <span class="text-overlay1 text-[10px] uppercase tracking-wider border border-overlay0 rounded px-1.5 py-0.5">
          private
        </span>
      )
    }
  </div>
</li>
