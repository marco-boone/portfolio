---
import Prompt from "./Prompt.astro";

// Renders the projects as `tree` command output.
// Tree guides are drawn with CSS (not box-drawing characters) so the
// vertical lines stay continuous when a description wraps onto more lines.

type Guide = "pipe" | "blank" | "tee" | "elbow";

interface Project {
  name: string;
  details?: string; // on-site detail page
  github?: string; // shown only for public projects
  private?: boolean;
  blurb?: string;
  files?: string[];
}

interface Category {
  dir: string;
  color: string; // color for the project names in this directory
  projects: Project[];
}

const tree: Category[] = [
  {
    dir: "featured",
    color: "text-green",
    projects: [
      {
        name: "ooo-riscv-cpu",
        details: "/projects/ooo-cpu",
        private: true,
        blurb: "out-of-order RISC-V core in SystemVerilog",
      },
    ],
  },
  {
    dir: "course",
    color: "text-mauve",
    projects: [
      {
        name: "lc2k-cpu",
        private: true,
        blurb: "pipelined LC2K processor in SystemVerilog",
      },
      {
        name: "mimu-glove",
        github: "https://github.com/marco-boone/373fp",
        blurb: "gesture-controlled audio glove on an STM32",
      },
    ],
  },
  {
    dir: "career",
    color: "text-peach",
    projects: [
      {
        name: "platformer",
        github: "https://github.com/marco-boone/3DPrintingPlatformer",
        blurb: "Unity platformer about 3D printing",
      },
    ],
  },
  {
    dir: "personal",
    color: "text-sky",
    projects: [
      {
        name: "minventory",
        private: true,
        blurb: "spending tracker web app",
      },
      {
        name: "neural-network",
        github: "https://github.com/marcoboone/Atombots_Simulation_ML_GA",
        blurb: "from-scratch neural net in C#",
      },
    ],
  },
];

type Row =
  | { kind: "category"; guides: Guide[]; dir: string }
  | { kind: "project"; guides: Guide[]; project: Project; color: string }
  | { kind: "blurb"; guides: Guide[]; text: string }
  | { kind: "links"; guides: Guide[]; details?: string; github?: string }
  | { kind: "file"; guides: Guide[]; name: string }
  | { kind: "spacer"; guides: Guide[] };

const rows: Row[] = [];
let dirCount = 0;
let fileCount = 0;

tree.forEach((cat, ci) => {
  const catLast = ci === tree.length - 1;
  rows.push({ kind: "category", guides: [catLast ? "elbow" : "tee"], dir: cat.dir });
  dirCount++;
  const catPrefix: Guide[] = [catLast ? "blank" : "pipe"];

  cat.projects.forEach((p, pi) => {
    const last = pi === cat.projects.length - 1;
    rows.push({
      kind: "project",
      guides: [...catPrefix, last ? "elbow" : "tee"],
      project: p,
      color: cat.color,
    });
    dirCount++;

    const own: Guide[] = [...catPrefix, last ? "blank" : "pipe"];
    const files = p.files ?? [];
    const infoGuides: Guide[] = [...own, "blank"];

    if (p.blurb) rows.push({ kind: "blurb", guides: infoGuides, text: p.blurb });
    const github = p.private ? undefined : p.github;
    if (p.details || github)
      rows.push({ kind: "links", guides: infoGuides, details: p.details, github });

    files.forEach((f, fi) => {
      rows.push({
        kind: "file",
        guides: [...own, "blank"],
        name: f,
      });
      fileCount++;
    });

    const isFinal = catLast && last;
    if (!isFinal) rows.push({ kind: "spacer", guides: own });
  });
});

const line = "absolute left-[0.5ch] w-px bg-overlay1";
const arm = "absolute left-[0.5ch] top-[0.5lh] h-px w-[2.75ch] bg-overlay1";
---

<div class="flex flex-col">
  <Prompt command="tree projects" class="mb-4" />

  <p class="font-bold text-blue">projects/</p>

  {
    rows.map((row) => (
      <div class="flex">
        {row.guides.map((g) => (
          <span class="relative w-[4ch] shrink-0" aria-hidden="true">
            {(g === "pipe" || g === "tee") && <span class:list={[line, "inset-y-0"]} />}
            {g === "elbow" && <span class:list={[line, "top-0 h-[0.5lh]"]} />}
            {(g === "tee" || g === "elbow") && <span class={arm} />}
          </span>
        ))}

        <div class="min-w-0 flex-1">
          {row.kind === "category" && <span class="font-bold text-blue">{row.dir}/</span>}

          {row.kind === "project" && (
            <span class="flex flex-wrap items-baseline gap-x-2">
              <span class:list={[row.color, "font-semibold"]}>{row.project.name}/</span>
              {row.project.private && <span class="text-xs text-overlay1">[private]</span>}
            </span>
          )}

          {row.kind === "blurb" && <p class="text-subtext0">{row.text}</p>}


          {row.kind === "links" && (
            <p class="flex gap-4">
              {row.details && <a class="link-accent" href={row.details}>details &rarr;</a>}
              {row.github && <a class="link-accent" href={row.github}>github</a>}
            </p>
          )}

          {row.kind === "file" && <span class="text-subtext1">{row.name}</span>}

          {row.kind === "spacer" && <div class="h-3" />}
        </div>
      </div>
    ))
  }

  <p class="mt-3 text-subtext0">{dirCount} directories, {fileCount} files</p>
</div>
