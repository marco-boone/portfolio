---
import Layout from "../layouts/layout.astro";
import PageShell from "../components/PageShell.astro";
import PageSection from "../components/PageSection.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
---

<Layout title="Projects">
  <PageShell>
    <PageSection path="~/projects">
      <div class="flex flex-col gap-8">
        <section class="flex flex-col gap-2">
          <h2 class="section-label">Featured</h2>
          <ul class="flex flex-col gap-3">
            <FeaturedProject
              title="OoO RISC-V CPU"
              href="/projects/ooo-cpu"
              github="https://github.com/marco-boone/"
              private
              blurb="2-wide superscalar, out-of-order RISC-V core in SystemVerilog, modeled on the MIPS R10K. EECS 472 team project."
              tags={["SystemVerilog", "computer architecture", "team of 4"]}
            />
            <FeaturedProject
              title="MiMU Glove"
              href="/projects/mimu-glove"
              github="https://github.com/marco-boone/373fp"
              blurb="Wireless gesture-controlled audio recorder/player glove, bare-metal C on an STM32 (Cortex-M4)."
              tags={["C", "STM32", "embedded"]}
            />
            <FeaturedProject
              title="Neural Network from Scratch"
              href="/projects/neural-network"
              github="https://github.com/marcoboone/Atombots_Simulation_ML_GA"
              blurb="Neural network written from scratch in C#, trained with a genetic algorithm to control swarm robots in Unity."
              tags={["C#", "Unity", "machine learning"]}
            />
          </ul>
        </section>

        <section class="flex flex-col gap-2">
          <h2 class="section-label">Course</h2>
          <ul class="flex flex-col gap-3 pl-1">
            <li class="flex flex-col gap-0.5">
              <div class="flex items-center gap-2">
                <a class="link-accent" href="https://github.com/marco-boone/">LC2K CPU</a>
                <span class="text-overlay1 text-[10px] uppercase tracking-wider border border-overlay0 rounded px-1.5 py-0.5">private</span>
              </div>
              <p class="text-subtext0">2-way in-order pipelined LC2K processor in SystemVerilog.</p>
              <ul class="text-subtext0 list-disc pl-5">
                <li>Out-of-order micro-op queue</li>
                <li>Bimodal branch prediction with banked BTB</li>
                <li>Direct-mapped I-cache</li>
                <li>1.6 CPI, 18.9 ns per instruction</li>
              </ul>
            </li>
          </ul>
        </section>

        <section class="flex flex-col gap-2">
          <h2 class="section-label">Career</h2>
          <ul class="flex flex-col gap-3 pl-1">
            <li class="flex flex-col gap-0.5">
              <a class="link-accent" href="https://github.com/marco-boone/3DPrintingPlatformer">platformer</a>
              <p class="text-subtext0">2D platformer in Unity (C#) about 3D printing, made for the S2A Research Lab and demoed at the SURE Symposium.</p>
            </li>
          </ul>
        </section>

        <section class="flex flex-col gap-2">
          <h2 class="section-label">Personal</h2>
          <ul class="flex flex-col gap-3 pl-1">
            <li class="flex flex-col gap-0.5">
              <div class="flex items-center gap-2">
                <a class="link-accent" href="https://github.com/marco-boone/minventory">minventory</a>
                <span class="text-overlay1 text-[10px] uppercase tracking-wider border border-overlay0 rounded px-1.5 py-0.5">private</span>
              </div>
              <p class="text-subtext0">Next.js/TypeScript app (Prisma + Supabase) that tracks everyday purchases to compute survival spend per day, week, month, and year. In invite-only alpha.</p>
            </li>
          </ul>
        </section>
      </div>
    </PageSection>
  </PageShell>
</Layout>
