---
import Layout from "../layouts/layout.astro";
import PageShell from "../components/PageShell.astro";
import PageSection from "../components/PageSection.astro";
---

<Layout title="Projects">
  <PageShell>
    <PageSection path="~/projects">
      <div class="flex flex-col gap-8">
        <section class="flex flex-col gap-2">
          <h2 class="section-label">Personal</h2>
          <ul class="flex flex-col gap-1.5 pl-1">
            <li>
              <a class="link-accent" href="https://github.com/marco-boone/chat-room">chat-room</a>
            </li>
            <li>
              <a class="link-accent" href="https://github.com/marco-boone/wordle-clone">wordle</a>
            </li>
            <li>
              <a class="link-accent" href="https://github.com/marco-boone/boids">boids</a>
            </li>
            <li>
              <a class="link-accent" href="https://github.com/marco-boone/gravity">gravity</a>
            </li>
          </ul>
        </section>

        <section class="flex flex-col gap-2">
          <h2 class="section-label">Career</h2>
          <ul class="flex flex-col gap-1.5 pl-1">
            <li>
              <a class="link-accent" href="https://github.com/marco-boone/3DPrintingPlatformer">platformer</a>
            </li>
          </ul>
        </section>

        <section class="flex flex-col gap-2">
          <h2 class="section-label">Course</h2>
          <ul class="flex flex-col gap-1.5 pl-1">
            <li>
              <a class="link-accent" href="https://github.com/marco-boone/">LC2K CPU</a>
            </li>
            <li>
              <a class="link-accent" href="https://github.com/marco-boone/373fp">MiMU Glove</a>
            </li>
          </ul>
        </section>
      </div>
    </PageSection>
  </PageShell>
</Layout>
