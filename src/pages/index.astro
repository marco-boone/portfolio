---
import Layout from "../layouts/layout.astro";
import PageShell from "../components/PageShell.astro";
import Prompt from "../components/Prompt.astro";
import ProjectsList from "../components/ProjectsList.astro";
import SectionHeader from "../components/SectionHeader.astro";

const links = [
  { label: "github", href: "https://github.com/marco-boone" },
  { label: "linkedin", href: "https://www.linkedin.com/in/marcoboone04" },
];
---

<Layout title="Portfolio">
  <PageShell>
    <section class="flex flex-col gap-5" aria-labelledby="about">
      <SectionHeader index="01" title="about" id="about" />
      <Prompt command="cat about.md" />

      <h1 class="flex flex-col gap-1">
        <span class="text-overlay2">//<span class="bg-yellow text-crust">TODO</span>: insert greeting,</span>
        <span class="text-xl font-bold text-text sm:text-2xl">i'm marco</span>
      </h1>

      <div class="flex flex-col gap-1">
        <p class="text-subtext0">
          21yo <span class="text-blue">computer engineering</span> student at
          <span class="text-blue">U</span>of<span class="text-yellow">M</span>
        </p>
        <p class="text-subtext0">
          incoming <span class="text-blue">swe</span> @ JPMC
        </p>
        <p class="text-subtext0">Ann Arbor, MI</p>
      </div>

      <ul class="flex flex-col gap-1">
        {
          links.map((l) => (
            <li class="text-overlay2">
              <span aria-hidden="true">- [</span><a class="link-accent" href={l.href}>{l.label}</a><span aria-hidden="true">](</span><span class="break-all">{l.href.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "")}</span><span aria-hidden="true">)</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14 flex flex-col gap-5" aria-labelledby="projects">
      <SectionHeader index="02" title="projects" id="projects" />
      <ProjectsList />
    </section>

    <Prompt class="mt-10" />
  </PageShell>
</Layout>
