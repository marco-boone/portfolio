---
import Layout from "../layouts/layout.astro";
import PageShell from "../components/PageShell.astro";
import PageSection from "../components/PageSection.astro";
---

<Layout title="SI — Math 215">
  <PageShell>
    <PageSection path="~/si/math215">
      <div class="flex flex-col gap-8 text-subtext0">
        <dl class="grid gap-2 sm:grid-cols-[5rem_1fr]">
          <dt class="font-semibold text-text">when</dt>
          <dd>Sunday from 1:00pm to 2:30pm</dd>
          <dt class="font-semibold text-text">where</dt>
          <dd>1372 East Hall — Central Campus</dd>
        </dl>

        <section class="flex flex-col gap-2">
          <h2 class="font-semibold text-text">session material</h2>
          <ul class="flex flex-col gap-1.5 pl-1">
            <li class="flex items-center gap-2">
              <span class="text-subtext0">09/13 session 1</span>
              <a class="link-accent" href="/si/math215/session_1.html">slides</a>
              <a class="link-accent" href="/si/math215/session_1.pdf">pdf</a>
            </li>
          </ul>
        </section>

        <section class="flex flex-col gap-2">
          <h2 class="font-semibold text-text">compiled resources</h2>
          <ul class="flex flex-col gap-1.5 pl-1">
            <li>
              <a class="link-accent" href="https://math.arizona.edu/~serinh/teaching/math215.html">notes by serin</a>
            </li>
            <li>
              <a class="link-accent" href="https://tutorial.math.lamar.edu/classes/calciii/calciii.aspx">notes by paul</a>
            </li>
            <li>
              <a class="link-accent" href="https://youtube.com/playlist?list=PL4C4C8A7D06566F38&si=SiuVBuEmhcdBW5SI">MIT lectures</a>
            </li>
            <li>
              <a class="link-accent" href="https://dept.math.lsa.umich.edu/courses/215/17exampractice/index.html">previous exams</a>
            </li>
            <li>
              <a class="link-accent" href="https://www.khanacademy.org/math/multivariable-calculus">Khan Academy</a>
            </li>
            <li>
              <a class="link-accent" href="https://lsa.umich.edu/math/undergraduates/course-resources/math-lab.html">math lab</a>
            </li>
            <li>
              <a class="link-accent" href="https://ecas.engin.umich.edu/elc/tutoring/">tutoring</a>
            </li>
            <li>
              <a class="link-accent" href="https://ecas.engin.umich.edu/elc-si-schedule/">SI schedule</a>
            </li>
          </ul>
        </section>
      </div>
    </PageSection>
  </PageShell>
</Layout>
