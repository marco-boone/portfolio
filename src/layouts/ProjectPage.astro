---
import Layout from "./layout.astro";
import PageShell from "../components/PageShell.astro";
import PageSection from "../components/PageSection.astro";

interface Props {
  slug: string;
  title: string;
  tagline: string;
  github?: string;
  role?: string;
  team?: string;
  timeline?: string;
}

const { slug, title, tagline, github, role, team, timeline } = Astro.props;
const facts = [role, team, timeline].filter(Boolean);
---

<Layout title={title}>
  <PageShell>
    <PageSection path={`~/projects/${slug}`}>
      <a class="link-accent w-fit text-xs" href="/#projects">&larr; back</a>

      <header class="flex flex-col gap-3">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text">{title}</h1>
        <p class="text-subtext0">{tagline}</p>
        {facts.length > 0 && <p class="text-overlay2 text-xs">{facts.join(" · ")}</p>}
        {
          github === "private" ? (
            <p class="text-overlay2 text-xs">github: private</p>
          ) : (
            github && (
              <a class="link-accent w-fit" href={github}>
                github
              </a>
            )
          )
        }
      </header>

      <div class="project-body pt-4">
        <slot />
      </div>
    </PageSection>
  </PageShell>
</Layout>
