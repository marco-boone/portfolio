---
import Layout from "./layout.astro";
import PageShell from "../components/PageShell.astro";
import PageSection from "../components/PageSection.astro";

interface Link {
  label: string;
  href: string;
}

interface Props {
  slug: string;
  title: string;
  tagline: string;
  tags?: string[];
  links?: Link[];
}

const { slug, title, tagline, tags = [], links = [] } = Astro.props;
---

<Layout title={title}>
  <PageShell>
    <PageSection path={`~/projects/${slug}`}>
      <a class="link-accent w-fit text-xs" href="/projects">&larr; all projects</a>

      <header class="flex flex-col gap-3">
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-text">{title}</h1>
        <p class="text-subtext0">{tagline}</p>
        {
          tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <li class="text-overlay2 text-[10px] uppercase tracking-wider border border-overlay0 rounded px-1.5 py-0.5">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
        {
          links.length > 0 && (
            <div class="flex flex-wrap gap-4">
              {links.map((link) => (
                <a class="link-accent" href={link.href}>
                  {link.label}
                </a>
              ))}
            </div>
          )
        }
      </header>

      <div class="project-body flex flex-col gap-10 pt-4">
        <slot />
      </div>
    </PageSection>
  </PageShell>
</Layout>
